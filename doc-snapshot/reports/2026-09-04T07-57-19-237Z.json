    {
      "docPath": "/angular/ag2/guides/frontend-tools-generative-ui",
      "url": "https://docs.copilotkit.ai/angular/ag2/guides/frontend-tools-generative-ui.md",
      "routes": [
        "/frontend-tools-generative-ui"
      ],
      "title": "Frontend tools and generative UI",
      "sha256": "e5604e134ee059624a607247bbd40564f0000bd8565da793faf46cde64da0a13",
      "bytes": 7881,
      "lines": 236,
      "outcome": "modified",
      "severity": "high",
      "hunks": [
        {
          "startLine": 8,
          "heading": "Let the agent display one of your components",
          "lines": [
            {
              "op": "context",
              "text": "to the same registration when the tool should show progress or a result in",
              "kind": "prose"
            },
            {
              "op": "context",
              "text": "chat.",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "## Let the agent display one of your components",
              "kind": "heading"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "The simplest generative UI there is, and the only kind that needs nothing on the",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "agent side. `registerComponent` registers a standalone component as a tool the",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "agent can call to show it. The agent decides when, and fills the props.",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "```ts title=\"src/app/incident-card.component.ts\"",
              "kind": "fence-open"
            },
            {
              "op": "add",
              "text": "import { Component, input } from \"@angular/core\";",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "import { AngularToolCall, ToolRenderer } from \"@copilotkit/angular\";",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "type IncidentArgs = { id: string; severity: string };",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "@Component({",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  selector: \"app-incident-card\",",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  standalone: true,",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  template: `",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "    @let call = toolCall();",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "    @if (call.status === \"in-progress\") {",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "      <p>Loading incident…</p>",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "    } @else {",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "      <article>",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "        <strong>{{ call.args.id }}</strong>",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "        <span>{{ call.args.severity }}</span>",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "      </article>",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "    }",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  `,",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "})",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "export class IncidentCardComponent implements ToolRenderer<IncidentArgs> {",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  readonly toolCall = input.required<AngularToolCall<IncidentArgs>>();",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "}",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "```",
              "kind": "fence-close"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "```ts",
              "kind": "fence-open"
            },
            {
              "op": "add",
              "text": "registerComponent({",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  name: \"show_incident\",",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  description: \"Show one incident from the incident table.\",",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  parameters: z.object({",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "    id: z.string().describe(\"The incident id, such as INC-4711\"),",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "    severity: z.string().describe(\"One of sev1, sev2, sev3\"),",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  }),",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "  component: IncidentCardComponent,",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "});",
              "kind": "code"
            },
            {
              "op": "add",
              "text": "```",
              "kind": "fence-close"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "There is no `handler`, and nothing changes in your agent. The tool is declared by",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "the frontend and forwarded over AG-UI, so this works the same behind a Python",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "agent as a TypeScript one.",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "<Callout type=\"warn\" title=\"A well-formed component is not a correct one\">",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "  The model fills these props from what it knows. A card rendered over records",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "  your application does not hold looks the same in the browser, in a screenshot,",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "  and in a video as a correct one. Share the page's data with the agent using",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "  [`CopilotKitAgentContext`](/reference/angular/directives/CopilotKitAgentContext),",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "  then read the rendered fields against the records you hold.",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "</Callout>",
              "kind": "prose"
            },
            {
              "op": "context",
              "text": "",
              "kind": "prose"
            }
          ]
        },
        {
          "startLine": 166,
          "heading": "Choose a generative UI path",
          "lines": [
            {
              "op": "context",
              "text": "| Path | Best fit | Angular setup |",
              "kind": "prose"
            },
            {
              "op": "context",
              "text": "| --- | --- | --- |",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "| Your components, display only | The agent should show a component and nothing else runs | `registerComponent` |",
              "kind": "prose"
            },
            {
              "op": "context",
              "text": "| Your components | Known data shapes and application actions | `registerFrontendTool` or `registerRenderToolCall` with a component |",
              "kind": "prose"
            }
          ]
        },
        {
          "startLine": 231,
          "heading": "Next steps",
          "lines": [
