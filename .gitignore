# Secrets. Neither the repo-root .env nor backend/.env was ignored here, so a
# `git add -A` staged a live OPENAI_API_KEY. backend/.env.example stays tracked.
.env
*/.env
.env.local

# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Angular & Build Outputs
dist/
tmp/
out-tsc/
.angular/

# Recorder output. Videos are build output -- reproducible from autorecorder/
# plus `npm run record` -- and committing them is expensive: the previous
# recorder's 13 clips in frontend/recordings/ were 51MB of tracked binaries,
# rewritten on every re-record. Publish them as release assets or to a bucket.
#
# Only the clips. `autorecorder/videos/` also holds manifest.json and
# MANIFEST.md, which `npm run manifest` writes and which are *meant* to be
# committed -- their diff is the only record of what a run changed, since the
# clips themselves are not in git. Ignoring the whole directory hid them.
autorecorder/videos/*.webm
.temp_chunks/

# Per-run pipeline output, for the same reason: a RUN_REPORT is regenerated by
# every recording run, unlike the manifest above.
autorecorder/videos/RUN_REPORT.*
autorecorder/videos/logs/

# Written after install by frontend/scripts/write-versions.ts. It describes one
# install, not the repo -- committing it means a stale file claiming to name
# what a later run resolved to.
frontend/VERSIONS.md

# Logs & OS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Stray recordings saved outside autorecorder/videos/ -- a clip dropped in the
# repo root or beside the code it shows matches none of the rules above, which
# is how a 66MB .mp4 and a 5.9MB .webm reached `git status` untracked. Video
# only: the voiceover assets in autorecorder/audio/ are .m4a and ARE committed.
*.webm
*.mp4
